[{"id": "0", "name": "Lahn River Avatar", "systemPromptUrl": "https://docs.google.com/document/d/1NYOOy8KkaLDBwvHvEVg1hVDY5yvHeLACUpCEkJVM8Kw", "contextDocsUrl": "https://drive.google.com/drive/folders/1vT4UTYHeFxS5Vy2u_OfQyQ6cQ-cP5Ywd?usp=sharing", "driveFolderId": "1vT4UTYHeFxS5Vy2u_OfQyQ6cQ-cP5Ywd", "sensorApiUrl": "https://api.thingspeak.com/channels/2974588/feeds.json?results=100", "sensorDescription": "You can access your (the Lahn river's) temperature, pH and other live readings here. This is the single source of truth for live river readings (pH, Dissolved Oxygen, Temp, Electrical Conductivity for water parameters and Humidity and CO2 for air parameters). Some questions require analysis of the data. For example: What was the\n  lowest temperature reading last week? Such questions require you to not just access the relevant data range, but perform a computation on it. Do what is necessary on the data, to obtain a response to the question. Use this to answer analytical questions about the live Lahn Atlas sensor data (pH, Dissolved Oxygen, Temp, Electrical Conductivity for water\n  parameters and Humidity and CO2 for air parameters) fetched from the ThingSpeak REST API.", "ragLanguages": ["en", "de"], "ttsVoiceId": "9904416a-0831-44ea-b8ee-5f145e8f9bbf", "ttsLanguage": "pt", "ragPinned": false, "llmDefaults": {"webSearchEnabled": true, "chat": {"provider": "gwdg", "model": "gwdg/openai-gpt-oss-120b", "temperature": 0.7, "top_k": 40, "top_p": 1}, "textQuery": {"provider": "gwdg", "model": "meta-llama-3.1-8b-instruct"}, "sensor": {"provider": "gwdg", "model": "gwdg/openai-gpt-oss-120b"}, "voiceChat": {"provider": "gwdg", "model": "gwdg/openai-gpt-oss-120b"}}, "defaultAvatar": false, "keywordMode": "llm"}, {"id": "1", "name": "Pathwork River", "systemPromptUrl": "https://docs.google.com/document/d/1psgn21hFQOitqJto1DR_eqJ_Q-a8Y-Jl3Bg3UDvc6jE/edit?usp=sharing", "contextDocsUrl": "https://drive.google.com/drive/folders/1PNCf2rds6mkKZL1PNGTgwHhK3uf5W3V2?usp=sharing", "driveFolderId": "1PNCf2rds6mkKZL1PNGTgwHhK3uf5W3V2", "sensorApiUrl": "", "ragLanguages": ["en", "de"], "llmDefaults": {"chat": {"provider": "gwdg", "model": "gwdg/openai-gpt-oss-120b", "temperature": 1, "top_k": 40, "top_p": 1}, "textQuery": {"provider": "gwdg", "model": "meta-llama-3.1-8b-instruct"}, "sensor": {"provider": "gwdg", "model": "gwdg/openai-gpt-oss-120b"}, "voiceChat": {"provider": "gwdg", "model": "gwdg/qwen3-30b-a3b-instruct-2507"}}, "ragPinned": false, "defaultAvatar": false}, {"id": "2", "name": "Rio Sagrado", "systemPromptUrl": "https://docs.google.com/document/d/19maGnqO6Zi4Vip3ia-UM9ECTcZkvwyxhZtRoN5hqKCU/edit?usp=sharing", "contextDocsUrl": "https://drive.google.com/drive/folders/1vIeF_JAw2XYKUl4PNxKrtveTE87VbUTE?usp=sharing", "driveFolderId": "1vIeF_JAw2XYKUl4PNxKrtveTE87VbUTE", "sensorApiUrl": "http://sympoiesis.xyz/rio-sagrado/sagradosensors.php?results=10", "sensorDescription": "You can access sensor readings from a sensor module installed in a waterspring in the Sagrado river's headwaters. From the dataset you can read Atmospheric Air temperature, humidity, pressure as well as a gas proxy (all from a BME688 sensor module), as well as water temperature (from a DS18B20 sensor) and water conductivity/TDS\n  (from a KS0429 keyestudio TDS Meter V1.0). All sensor modules are connected to an ESP32s3 microcontroller. You can fetch the data points using a dedicated API endpoint that retrieves data from a MySQL dataset that is updated every 30 minutes with new readings. Access the Biodata Sensor API at http://sympoiesis.xyz/sagradosensors.php via GET requests to\n  retrieve JSON-formatted sensor data. By default, it returns the 100 most recent entries sorted newest-first, but you can adjust the volume with results (max 1000), paginate with offset, or filter by time using start and end parameters (format: YYYY-MM-DD HH:MM:SS).", "ragLanguages": ["pt", "en"], "ttsVoiceId": "e1717dc3-b87b-4720-aa7f-b6db290e0609", "ttsLanguage": "pt", "ragPinned": true